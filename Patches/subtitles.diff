+// ---------------------------------------------------------------------------
+// D7 - dialogue / subtitle channel
+// ---------------------------------------------------------------------------
+
+void UMissionSubsystem::BuildCueLibrary(const TArray<FVeilDialogueCue>& InCues)
+{
+	CueLibrary.Empty(InCues.Num());
+	for (const FVeilDialogueCue& Cue : InCues)
+	{
+		if (Cue.CueId.IsNone())
+		{
+			UE_LOG(LogVeil, Warning, TEXT("Dialogue cue with no CueId skipped."));
+			continue;
+		}
+		CueLibrary.Add(Cue.CueId, Cue);
+	}
+}
+
+void UMissionSubsystem::RegisterCueTable(UDataTable* InCueTable)
+{
+	TArray<FVeilDialogueCue> Cues;
+
+	if (InCueTable)
+	{
+		TArray<FVeilDialogueCue*> Rows;
+		InCueTable->GetAllRows<FVeilDialogueCue>(TEXT("UMissionSubsystem::RegisterCueTable"), Rows);
+		Cues.Reserve(Rows.Num());
+		for (const FVeilDialogueCue* Row : Rows)
+		{
+			if (Row)
+			{
+				Cues.Add(*Row);
+			}
+		}
+	}
+
+	if (Cues.Num() == 0)
+	{
+		// A missing or empty table must not leave the game mute.
+		UE_LOG(LogVeil, Warning, TEXT("Cue table empty or null - falling back to the built-in registry."));
+		VeilDialogue::GetDefaultCues(Cues);
+	}
+
+	BuildCueLibrary(Cues);
+	UE_LOG(LogVeil, Log, TEXT("Registered %d dialogue cues."), CueLibrary.Num());
+}
+
+void UMissionSubsystem::PlayObjectiveStartCue()
+{
+	if (Objectives.IsValidIndex(CurrentIndex) && !Objectives[CurrentIndex].StartCueId.IsNone())
+	{
+		PlayCue(Objectives[CurrentIndex].StartCueId);
+	}
+}
+
+bool UMissionSubsystem::PlayCue(FName CueId)
+{
+	if (CueId.IsNone())
+	{
+		return false;
+	}
+	const FVeilDialogueCue* Cue = CueLibrary.Find(CueId);
+	if (!Cue)
+	{
+		UE_LOG(LogVeil, Warning, TEXT("PlayCue: unknown cue '%s'."), *CueId.ToString());
+		return false;
+	}
+	return TryPlayCue(*Cue, /*bForce=*/false);
+}
+
+bool UMissionSubsystem::PlayCueBank(FName BankId)
+{
+	if (BankId.IsNone())
+	{
+		return false;
+	}
+
+	const FName* LastPtr = LastBankPull.Find(BankId);
+	const FName Last = LastPtr ? *LastPtr : NAME_None;
+
+	TArray<const FVeilDialogueCue*> Eligible;
+	TArray<const FVeilDialogueCue*> Fallback;
+	for (const TPair<FName, FVeilDialogueCue>& Pair : CueLibrary)
+	{
+		const FVeilDialogueCue& Cue = Pair.Value;
+		if (Cue.Repeat != EVeilCueRepeat::Bank || Cue.BankId != BankId)
+		{
+			continue;
+		}
+		if (const float* Stamp = LastPlayTime.Find(Cue.CueId))
+		{
+			if (DialogueClock - *Stamp < Cue.CooldownSeconds)
+			{
+				continue;
+			}
+		}
+		Fallback.Add(&Cue);
+		if (Cue.CueId != Last)
+		{
+			Eligible.Add(&Cue);
+		}
+	}
+
+	// "No immediate repeats" is a preference, not a reason to say nothing at
+	// all: a one-line bank falls back to itself.
+	const TArray<const FVeilDialogueCue*>& Pool = Eligible.Num() > 0 ? Eligible : Fallback;
+	if (Pool.Num() == 0)
+	{
+		return false;
+	}
+
+	const FVeilDialogueCue* Pick = Pool[FMath::RandRange(0, Pool.Num() - 1)];
+	return TryPlayCue(*Pick, /*bForce=*/false);
+}
+
+void UMissionSubsystem::StopAllDialogue()
+{
+	ActiveLine.Clear();
+	PendingLines.Reset();
+	ChannelFreeSince = DialogueClock;
+}
+
+bool UMissionSubsystem::TryPlayCue(const FVeilDialogueCue& Cue, bool bForce)
+{
+	if (bForce)
+	{
+		BeginLine(Cue);
+		return true;
+	}
+
+	if (bPlayerDead)
+	{
+		return false;
+	}
+
+	// --- repeat rules ---
+	if (Cue.Repeat == EVeilCueRepeat::Once)
+	{
+		if (PlayedOnce.Contains(Cue.CueId))
+		{
+			return false;
+		}
+	}
+	else if (const float* Stamp = LastPlayTime.Find(Cue.CueId))
+	{
+		if (DialogueClock - *Stamp < Cue.CooldownSeconds)
+		{
+			return false;
+		}
+	}
+
+	// --- channel rules (one voice, see the priority table in D3) ---
+	if (!ActiveLine.IsValid())
+	{
+		if (Cue.Priority == EVeilCuePriority::P4_Reactive
+			&& (DialogueClock - ChannelFreeSince) < VeilDialogue::ReactiveQuietSeconds)
+		{
+			return false;
+		}
+		BeginLine(Cue);
+		return true;
+	}
+
+	// Hints and reactive chatter never talk over anything.
+	if (Cue.Priority == EVeilCuePriority::P3_Hint || Cue.Priority == EVeilCuePriority::P4_Reactive)
+	{
+		return false;
+	}
+
+	const uint8 NewPriority = static_cast<uint8>(Cue.Priority);
+	const uint8 ActivePriority = static_cast<uint8>(ActiveLine.Priority);
+	const bool bQueueable = (Cue.Priority == EVeilCuePriority::P0_Scripted
+		|| Cue.Priority == EVeilCuePriority::P1_Objective);
+
+	// Scripted story is never cut. Everything else queues or drops.
+	if (ActiveLine.Priority == EVeilCuePriority::P0_Scripted)
+	{
+		return bQueueable ? EnqueueLine(Cue) : false;
+	}
+
+	if (NewPriority < ActivePriority)
+	{
+		// A line short enough to be over almost immediately is allowed to
+		// finish - cutting it reads as a bug, not as urgency.
+		if (ActiveLine.Duration <= VeilDialogue::ShortCueGraceSeconds)
+		{
+			return EnqueueLine(Cue);
+		}
+		BeginLine(Cue);
+		return true;
+	}
+
+	return bQueueable ? EnqueueLine(Cue) : false;
+}
+
+void UMissionSubsystem::MarkPlayed(const FVeilDialogueCue& Cue)
+{
+	if (Cue.Repeat == EVeilCueRepeat::Once)
+	{
+		PlayedOnce.Add(Cue.CueId);
+	}
+	else
+	{
+		LastPlayTime.Add(Cue.CueId, DialogueClock);
+	}
+	if (Cue.Repeat == EVeilCueRepeat::Bank && !Cue.BankId.IsNone())
+	{
+		LastBankPull.Add(Cue.BankId, Cue.CueId);
+	}
+}
+
+void UMissionSubsystem::UnmarkPlayed(FName CueId)
+{
+	if (const FVeilDialogueCue* Cue = CueLibrary.Find(CueId))
+	{
+		if (Cue->Repeat == EVeilCueRepeat::Once)
+		{
+			PlayedOnce.Remove(CueId);
+		}
+		else
+		{
+			LastPlayTime.Remove(CueId);
+		}
+	}
+}
+
+void UMissionSubsystem::BeginLine(const FVeilDialogueCue& Cue)
+{
+	ActiveLine.CueId = Cue.CueId;
+	ActiveLine.Speaker = Cue.Speaker;
+	ActiveLine.Line = Cue.Line;
+	ActiveLine.NextCueId = Cue.NextCueId;
+	ActiveLine.Priority = Cue.Priority;
+	ActiveLine.Duration = Cue.DurationOverride > 0.f
+		? Cue.DurationOverride
+		: VeilDialogue::DeriveDuration(Cue.Line);
+	ActiveLine.Elapsed = 0.f;
+
+	MarkPlayed(Cue);
+}
+
+bool UMissionSubsystem::EnqueueLine(const FVeilDialogueCue& Cue)
+{
+	if (PendingLines.Num() >= VeilDialogue::MaxQueuedLines)
+	{
+		// The queue is priority-sorted, so the worst line is the last one.
+		const int32 Worst = PendingLines.Num() - 1;
+		if (static_cast<uint8>(Cue.Priority) >= static_cast<uint8>(PendingLines[Worst].Priority))
+		{
+			return false;
+		}
+		UnmarkPlayed(PendingLines[Worst].CueId);
+		PendingLines.RemoveAt(Worst);
+	}
+
+	FVeilActiveLine Line;
+	Line.CueId = Cue.CueId;
+	Line.Speaker = Cue.Speaker;
+	Line.Line = Cue.Line;
+	Line.NextCueId = Cue.NextCueId;
+	Line.Priority = Cue.Priority;
+	Line.Duration = Cue.DurationOverride > 0.f
+		? Cue.DurationOverride
+		: VeilDialogue::DeriveDuration(Cue.Line);
+	Line.Elapsed = 0.f;
+
+	int32 InsertAt = PendingLines.Num();
+	for (int32 i = 0; i < PendingLines.Num(); ++i)
+	{
+		if (static_cast<uint8>(PendingLines[i].Priority) > static_cast<uint8>(Line.Priority))
+		{
+			InsertAt = i;
+			break;
+		}
+	}
+	PendingLines.Insert(Line, InsertAt);
+
+	MarkPlayed(Cue);
+	return true;
+}
+
+void UMissionSubsystem::Tick(float DeltaTime)
+{
+	DialogueClock += DeltaTime;
+
+	if (ActiveLine.IsValid())
+	{
+		ActiveLine.Elapsed += DeltaTime;
+		if (ActiveLine.Elapsed >= ActiveLine.Duration)
+		{
+			const FName NextCueId = ActiveLine.NextCueId;
+			ActiveLine.Clear();
+			ChannelFreeSince = DialogueClock;
+
+			// A chained line continues the same breath: no gates, no queue.
+			if (!NextCueId.IsNone())
+			{
+				if (const FVeilDialogueCue* Next = CueLibrary.Find(NextCueId))
+				{
+					TryPlayCue(*Next, /*bForce=*/true);
+					return;
+				}
+				UE_LOG(LogVeil, Warning, TEXT("Dangling NextCueId '%s'."), *NextCueId.ToString());
+			}
+		}
+	}
+
+	if (!ActiveLine.IsValid() && PendingLines.Num() > 0)
+	{
+		ActiveLine = PendingLines[0];
+		ActiveLine.Elapsed = 0.f;
+		PendingLines.RemoveAt(0);
+	}
+}
+
+bool UMissionSubsystem::HasActiveLine() const
+{
+	return ActiveLine.IsValid();
+}
+
+FText UMissionSubsystem::GetActiveLineText() const
+{
+	return ActiveLine.IsValid() ? ActiveLine.Line : FText::GetEmpty();
+}
+
+FName UMissionSubsystem::GetActiveLineSpeaker() const
+{
+	return ActiveLine.IsValid() ? ActiveLine.Speaker : NAME_None;
+}
+
+float UMissionSubsystem::GetActiveLineAlpha() const
+{
+	if (!ActiveLine.IsValid())
+	{
+		return 0.f;
+	}
+	const float FadeIn = FMath::Clamp(ActiveLine.Elapsed / VeilDialogue::FadeSeconds, 0.f, 1.f);
+	const float FadeOut = FMath::Clamp(
+		(ActiveLine.Duration - ActiveLine.Elapsed) / VeilDialogue::FadeSeconds, 0.f, 1.f);
+	return FMath::Min(FadeIn, FadeOut);
+}
+
 #undef LOCTEXT_NAMESPACE
