+// Veil of Succession - fictional political thriller. All characters fictitious.
+//
+// D7 built-in dialogue registry. Every line here is the canon text from
+// Docs/MISSION_SCRIPTS.md as organised in Docs/drafts/darya_earpiece.md, with
+// typographic punctuation folded to ASCII to match the rest of the codebase.
+// The user's voice pass happens in Content/Data/VeilDialogueCues.csv, which is
+// generated from this same list and can be imported as a UDataTable and handed
+// to UMissionSubsystem::RegisterCueTable to override everything below.
+#include "VeilDialogue.h"
+
+#define LOCTEXT_NAMESPACE "VeilDialogue"
+
+float VeilDialogue::DeriveDuration(const FText& Line)
+{
+	const FString S = Line.ToString();
+	TArray<FString> Words;
+	S.ParseIntoArrayWS(Words);
+	const float Raw = (Words.Num() / WordsPerSecond) + TailSeconds;
+	return FMath::Clamp(Raw, MinLineSeconds, MaxLineSeconds);
+}
+
+void VeilDialogue::GetDefaultCues(TArray<FVeilDialogueCue>& OutCues)
+{
+	OutCues.Reset();
+
+	auto Add = [&OutCues](FName InId, FName InSpeaker, const FText& InLine,
+		EVeilCuePriority InPriority, EVeilCueRepeat InRepeat,
+		FName InBankId, FName InNextCueId, float InCooldown)
+	{
+		FVeilDialogueCue Cue;
+		Cue.CueId = InId;
+		Cue.Speaker = InSpeaker;
+		Cue.Line = InLine;
+		Cue.Priority = InPriority;
+		Cue.Repeat = InRepeat;
+		Cue.BankId = InBankId;
+		Cue.NextCueId = InNextCueId;
+		Cue.CooldownSeconds = InCooldown;
+		Cue.DurationOverride = 0.f;
+		OutCues.Add(MoveTemp(Cue));
+	};
+
+	Add(TEXT("M0_CO_1"), TEXT("Darya"),
+		LOCTEXT("M0_CO_1", "You're on the wall's blind side. Cameras sweep left to right, thirty-second cycle. There's a reception breaking up in the east garden - stay to its edge and you're just another guest who's had too much tea."),
+		EVeilCuePriority::P0_Scripted, EVeilCueRepeat::Once, TEXT(""), TEXT("M0_CO_2"), 0.f);
+	Add(TEXT("M0_CO_2"), TEXT("Yas"),
+		LOCTEXT("M0_CO_2", "And if someone asks whose guest I am?"),
+		EVeilCuePriority::P0_Scripted, EVeilCueRepeat::Once, TEXT(""), TEXT("M0_CO_3"), 0.f);
+	Add(TEXT("M0_CO_3"), TEXT("Darya"),
+		LOCTEXT("M0_CO_3", "You're Custodian Rahimi's daughter. Nobody asks the Rahimi girl anything. That's the whole plan."),
+		EVeilCuePriority::P0_Scripted, EVeilCueRepeat::Once, TEXT(""), TEXT("M0_CO_4"), 0.f);
+	Add(TEXT("M0_CO_4"), TEXT("Yas"),
+		LOCTEXT("M0_CO_4", "Comforting."),
+		EVeilCuePriority::P0_Scripted, EVeilCueRepeat::Once, TEXT(""), TEXT("M0_CO_5"), 0.f);
+	Add(TEXT("M0_CO_5"), TEXT("Darya"),
+		LOCTEXT("M0_CO_5", "It's not meant to be. Get to the palace doors before the Council rises. Your father is in that room, Yas. Move like you belong and no one will look twice."),
+		EVeilCuePriority::P0_Scripted, EVeilCueRepeat::Once, TEXT(""), TEXT(""), 0.f);
+	Add(TEXT("M0_EG_START"), TEXT("Darya"),
+		LOCTEXT("M0_EG_START", "Over you go. Keep low along the hedge line - the spotlights don't reach the roses."),
+		EVeilCuePriority::P1_Objective, EVeilCueRepeat::Once, TEXT(""), TEXT(""), 0.f);
+	Add(TEXT("M0_EG_SPOT"), TEXT("Darya"),
+		LOCTEXT("M0_EG_SPOT", "Light incoming, right to left. Behind the fountain. Wait for it to pass."),
+		EVeilCuePriority::P2_Conditional, EVeilCueRepeat::Once, TEXT(""), TEXT(""), 0.f);
+	Add(TEXT("M0_EG_GUESTS"), TEXT("Darya"),
+		LOCTEXT("M0_EG_GUESTS", "Those are guests, not guards. Don't dart them, don't spook them. A screaming undersecretary is worse than any alarm."),
+		EVeilCuePriority::P2_Conditional, EVeilCueRepeat::ReArm, TEXT(""), TEXT(""), 30.0f);
+	Add(TEXT("M0_EG_SPRINT"), TEXT("Darya"),
+		LOCTEXT("M0_EG_SPRINT", "Slow down. A guest strolls. Only the guilty run."),
+		EVeilCuePriority::P2_Conditional, EVeilCueRepeat::ReArm, TEXT(""), TEXT(""), 20.0f);
+	Add(TEXT("M0_EG_DONE"), TEXT("Darya"),
+		LOCTEXT("M0_EG_DONE", "Good. You're inside the garden proper now. That's the last easy part of the night."),
+		EVeilCuePriority::P1_Objective, EVeilCueRepeat::Once, TEXT(""), TEXT(""), 0.f);
+	Add(TEXT("M0_KC_START"), TEXT("Darya"),
+		LOCTEXT("M0_KC_START", "See the captain by the cypress? Omid Shirazi. Palace guard, off the clock, sneaking a cigarette he swore to his wife he'd quit. His card opens the inner doors."),
+		EVeilCuePriority::P1_Objective, EVeilCueRepeat::Once, TEXT(""), TEXT("M0_KC_START_2"), 0.f);
+	Add(TEXT("M0_KC_START_2"), TEXT("Yas"),
+		LOCTEXT("M0_KC_START_2", "You want me to ask him nicely."),
+		EVeilCuePriority::P1_Objective, EVeilCueRepeat::Once, TEXT(""), TEXT("M0_KC_START_3"), 0.f);
+	Add(TEXT("M0_KC_START_3"), TEXT("Darya"),
+		LOCTEXT("M0_KC_START_3", "I want you to take it off him without him ever knowing it's gone. Come up behind while he's still. Ease - don't grab."),
+		EVeilCuePriority::P1_Objective, EVeilCueRepeat::Once, TEXT(""), TEXT(""), 0.f);
+	Add(TEXT("M0_KC_TURN"), TEXT("Darya"),
+		LOCTEXT("M0_KC_TURN", "He's turning - break off, break off. Be a woman admiring the roses."),
+		EVeilCuePriority::P2_Conditional, EVeilCueRepeat::ReArm, TEXT(""), TEXT(""), 10.0f);
+	Add(TEXT("M0_KC_STALL"), TEXT("Darya"),
+		LOCTEXT("M0_KC_STALL", "He finishes that cigarette in ninety seconds and walks. Behind him, close, patient."),
+		EVeilCuePriority::P2_Conditional, EVeilCueRepeat::Once, TEXT(""), TEXT(""), 0.f);
+	Add(TEXT("M0_KC_DONE"), TEXT("Yas"),
+		LOCTEXT("M0_KC_DONE", "Sorry, Captain. Give my regards to your wife."),
+		EVeilCuePriority::P1_Objective, EVeilCueRepeat::Once, TEXT(""), TEXT("M0_KC_DONE_2"), 0.f);
+	Add(TEXT("M0_KC_DONE_2"), TEXT("Darya"),
+		LOCTEXT("M0_KC_DONE_2", "Clean. He'll pat his pocket at the gate and blame the tailor. Card's live - get to the doors."),
