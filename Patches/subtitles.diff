+void AVeilHUD::WrapToWidth(const FString& Text, UFont* Font, float MaxWidth, TArray<FString>& OutLines)
+{
+	OutLines.Reset();
+	TArray<FString> Words;
+	Text.ParseIntoArrayWS(Words);
+
+	FString Current;
+	for (const FString& W : Words)
+	{
+		const FString Candidate = Current.IsEmpty() ? W : Current + TEXT(" ") + W;
+		float TW = 0.f, TH = 0.f;
+		GetTextSize(Candidate, TW, TH, Font);
+		if (TW > MaxWidth && !Current.IsEmpty())
+		{
+			OutLines.Add(Current);
+			Current = W;
+		}
+		else
+		{
+			Current = Candidate;
+		}
+	}
+	if (!Current.IsEmpty())
+	{
+		OutLines.Add(Current);
+	}
+}
+
+void AVeilHUD::DrawSubtitles(UMissionSubsystem* Mission, float SW, float SH)
+{
+	if (!Mission || !Mission->HasActiveLine() || !GEngine)
+	{
+		return;
+	}
+
+	const float Alpha = Mission->GetActiveLineAlpha();
+	if (Alpha <= 0.01f)
+	{
+		return;
+	}
+
+	UFont* Font = GEngine->GetLargeFont();
+	TArray<FString> Lines;
+	WrapToWidth(Mission->GetActiveLineText().ToString(), Font, SW * 0.62f, Lines);
+	if (Lines.Num() == 0)
+	{
+		return;
+	}
+
+	// Speaker colour is the only thing separating two voices on one channel.
+	const FName Speaker = Mission->GetActiveLineSpeaker();
+	FLinearColor SpeakerCol(1.f, 0.85f, 0.5f);
+	if (Speaker == FName(TEXT("Darya")))
+	{
+		SpeakerCol = FLinearColor(0.55f, 0.85f, 1.f);
+	}
+	else if (Speaker == FName(TEXT("Yas")))
+	{
+		SpeakerCol = FLinearColor(1.f, 1.f, 1.f);
+	}
+
+	float ProbeW = 0.f, LineH = 0.f;
+	GetTextSize(Lines[0], ProbeW, LineH, Font);
+	if (LineH <= 0.f)
+	{
+		LineH = 18.f;
+	}
+	const float Step = LineH + 4.f;
+
+	// Anchored above the controls hint and clear of the bottom-left bars.
+	const float BlockBottom = SH * 0.88f;
+	const float BlockTop = BlockBottom - Step * Lines.Num();
+	const float SpeakerY = BlockTop - Step;
+
+	// Scrim, or a bright marble wall eats the text.
+	DrawRect(FLinearColor(0.f, 0.f, 0.f, 0.45f * Alpha),
+		SW * 0.5f - SW * 0.34f, SpeakerY - 8.f,
+		SW * 0.68f, Step * (Lines.Num() + 1) + 14.f);
+
+	if (!Speaker.IsNone())
+	{
+		DrawCenteredLabel(Speaker.ToString().ToUpper(), SW * 0.5f, SpeakerY,
+			FLinearColor(SpeakerCol.R, SpeakerCol.G, SpeakerCol.B, Alpha), false);
+	}
+	for (int32 i = 0; i < Lines.Num(); ++i)
+	{
+		DrawCenteredLabel(Lines[i], SW * 0.5f, BlockTop + Step * i,
+			FLinearColor(0.96f, 0.96f, 0.96f, Alpha), true);
+	}
+}
