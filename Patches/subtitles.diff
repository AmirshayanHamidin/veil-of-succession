+// Veil of Succession - fictional political thriller. All characters fictitious.
+//
+// D7: dialogue-cue types for the subtitle system. The runtime channel lives in
+// UMissionSubsystem; this header only describes WHAT a cue is, so the data can
+// come from either the built-in registry (VeilDialogue.cpp) or a UDataTable
+// imported from Content/Data/VeilDialogueCues.csv.
+#pragma once
+
+#include "CoreMinimal.h"
+#include "Engine/DataTable.h"
+#include "VeilDialogue.generated.h"
+
+// One voice channel. Lower value = higher priority (see Docs/drafts/darya_earpiece.md).
+UENUM()
+enum class EVeilCuePriority : uint8
+{
+	// Scripted story: cold open, Council scene, throne-room exchange, closing.
+	// Never interrupted; everything else queues or drops.
+	P0_Scripted    UMETA(DisplayName = "P0 Scripted story"),
+	// Objective start / complete. Interrupts P2-P4, queues behind P0.
+	P1_Objective   UMETA(DisplayName = "P1 Objective"),
+	// Conditional / ambient mission cues. Interrupts P3-P4 only.
+	P2_Conditional UMETA(DisplayName = "P2 Conditional"),
+	// Hint ladder. Plays only if the channel is free.
+	P3_Hint        UMETA(DisplayName = "P3 Hint"),
+	// Reactive banks and idles. Plays only if the channel has been free a while.
+	P4_Reactive    UMETA(DisplayName = "P4 Reactive")
+};
+
+UENUM()
+enum class EVeilCueRepeat : uint8
+{
+	// Fires once per campaign run. Survives checkpoint restarts by design:
+	// a replayed objective must NOT replay its cold open (canon).
+	Once  UMETA(DisplayName = "Once"),
+	// May fire again once CooldownSeconds have passed.
+	ReArm UMETA(DisplayName = "Re-arm"),
+	// Random pull from the cues sharing BankId; never the same one twice running.
+	Bank  UMETA(DisplayName = "Bank")
+};
+
+// A single authored line. FTableRowBase so the whole table can be swapped for a
+// designer-editable UDataTable without touching code.
+USTRUCT()
+struct FVeilDialogueCue : public FTableRowBase
+{
+	GENERATED_BODY()
+
+	// Stable id, e.g. M0_EG_START. Row names in the CSV are Cue_<CueId>.
+	UPROPERTY(EditAnywhere) FName CueId;
+
+	// Darya / Yas / Azadi / Hossein. Drives the on-screen name and its colour.
+	UPROPERTY(EditAnywhere) FName Speaker;
+
+	UPROPERTY(EditAnywhere) FText Line;
+
+	UPROPERTY(EditAnywhere) EVeilCuePriority Priority = EVeilCuePriority::P2_Conditional;
+
+	UPROPERTY(EditAnywhere) EVeilCueRepeat Repeat = EVeilCueRepeat::Once;
+
+	// Only meaningful when Repeat == Bank.
+	UPROPERTY(EditAnywhere) FName BankId;
+
+	// Multi-line exchanges are authored as a chain: when this line ends, the
+	// next one plays immediately at the same priority, bypassing the gates.
+	UPROPERTY(EditAnywhere) FName NextCueId;
+
+	// Only meaningful when Repeat == ReArm.
+	UPROPERTY(EditAnywhere) float CooldownSeconds = 20.f;
+
+	// 0 = derive the duration from the word count (never hand-author these).
+	UPROPERTY(EditAnywhere) float DurationOverride = 0.f;
+};
+
+// The line currently occupying the channel.
+USTRUCT()
+struct FVeilActiveLine
+{
+	GENERATED_BODY()
+
+	UPROPERTY() FName CueId;
+	UPROPERTY() FName Speaker;
+	UPROPERTY() FText Line;
+	UPROPERTY() FName NextCueId;
+	UPROPERTY() EVeilCuePriority Priority = EVeilCuePriority::P4_Reactive;
+	UPROPERTY() float Duration = 0.f;
+	UPROPERTY() float Elapsed = 0.f;
+
